{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["cert", "key"],
  "properties": {
    "listen": {
      "type": "string",
      "minLength": 1
    },
    "cert": {
      "type": "string",
      "minLength": 1
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "ca_cert": {
      "type": ["string", "null"]
    },
    "routes": {
      "type": "array",
      "items": { "$ref": "#/definitions/route" },
      "default": []
    }
  },
  "definitions": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match", "parser"],
      "properties": {
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "app_name": { "type": "string" },
            "hostname_pattern": { "type": "string" },
            "facility": { "type": "string" }
          }
        },
        "parser": {
          "type": "string",
          "enum": ["ssh", "nginx", "postfix", "iptables", "cisco_asa", "pfsense", "custom", "drop"]
        },
        "pattern": { "type": ["string", "null"] }
      }
    }
  }
}