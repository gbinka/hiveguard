{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["path", "detector", "pattern"],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "detector": {
      "type": "string",
      "minLength": 1
    },
    "pattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "seek_to_end": {
      "type": "boolean",
      "default": true
    }
  }
}
