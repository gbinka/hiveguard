{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "source.nats",
  "description": "NATS / JetStream consumer log source. Full schema delegated to hiveguard_core::config::NatsSourceConfig.",
  "type": "object",
  "additionalProperties": true,
  "required": ["servers", "subject"],
  "properties": {
    "servers": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "subject": { "type": "string", "minLength": 1 }
  }
}
