{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sink.elastic",
  "type": "object",
  "additionalProperties": true,
  "required": ["url"],
  "properties": {
    "url": {
      "type": "string",
      "description": "Elasticsearch base URL (e.g. https://elastic.example.com:9200)."
    },
    "index": {
      "type": "string",
      "default": "hiveguard-events"
    },
    "username": { "type": ["string", "null"] },
    "password": { "type": ["string", "null"] },
    "batch_size": { "type": "integer", "default": 100, "minimum": 1 },
    "flush_interval_secs": { "type": "integer", "default": 10, "minimum": 1 },
    "timeout_secs": { "type": "integer", "default": 30, "minimum": 1 },
    "verify_tls": { "type": "boolean", "default": true }
  }
}
