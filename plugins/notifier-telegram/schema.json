{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "notifier.telegram",
  "type": "object",
  "additionalProperties": false,
  "required": ["bot_token", "chat_id"],
  "properties": {
    "bot_token":   { "type": "string", "minLength": 1, "description": "Telegram bot token (use ${env:...})" },
    "chat_id":     { "type": "string", "minLength": 1, "description": "Telegram chat ID (string or numeric)" },
    "timeout_secs": { "type": "integer", "minimum": 1, "maximum": 60, "default": 10 },
    "parse_mode":  { "type": "string", "enum": ["Markdown", "MarkdownV2", "HTML"], "default": "Markdown" }
  }
}
